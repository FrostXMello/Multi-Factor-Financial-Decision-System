# Copy to .env and fill in only on a machine that is allowed to use the feed.
# Do not commit .env. Empty live credentials mean no live request is sent.

# SQLite file. Relative paths are resolved from the process working directory.
MARKET_DATA_DB=data/market.sqlite

# Symbols the collector may request when the NSE cash session is open.
MARKET_DATA_WATCHLIST=RELIANCE.NS,TCS.NS,HDFCBANK.NS

# Official broker quote API. Leave blank until you have a licensed feed.
# The adapter expects GET {BROKER_LIVE_BASE_URL}{BROKER_LIVE_QUOTES_PATH}?symbols=A,B
# and JSON {"quotes": [{"symbol", "price", "time", "bid", "ask", "volume", "freshness"}]}.
# freshness is stored as delayed when the payload does not say "live".
BROKER_LIVE_BASE_URL=
BROKER_API_KEY=
BROKER_ACCESS_TOKEN=
BROKER_LIVE_QUOTES_PATH=/quotes

# Optional WebSocket URL for a later official streaming client.
# This project does not bundle a socket client. Polling is the fallback.
BROKER_LIVE_WS_URL=

# Isolated paper-trading ledger (never a live broker). Relative paths are local.
PAPER_TRADING_DB=data/paper.sqlite

# FastAPI CORS allow-list for the React terminal (comma-separated).
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional AI explainability provider (OpenAI-compatible chat completions).
# Leave blank to use deterministic explanations only. Keys never leave the backend.
AI_REASONING_PROVIDER=openai_compatible
AI_REASONING_BASE_URL=
AI_REASONING_API_KEY=
AI_REASONING_MODEL=gpt-4o-mini
AI_REASONING_CHAT_PATH=/chat/completions
AI_REASONING_TIMEOUT_S=20
